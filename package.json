{
  "name": "naprawnik-android",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android wrapper for the NAPRAWNIK workshop app",
  "scripts": {
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "mobile:sync": "npm run mobile:prepare && npx cap sync android",
    "mobile:android": "npm run mobile:prepare && npx cap add android && npx cap sync android",
    "mobile:assets": "npx @capacitor/assets generate --android",
    "mobile:bundle-native": "esbuild scripts/native-bridge.js --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=www/native-bridge.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/status-bar": "8.0.4",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/assets": "3.0.5",
    "sharp": "0.35.5",
    "esbuild": "0.28.2"
  }
}
